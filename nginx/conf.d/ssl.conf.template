# Rename to ssl.conf once Certbot certificates are obtained for st.uzbek-talim.uz

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name st.uzbek-talim.uz;

    ssl_certificate /etc/letsencrypt/live/st.uzbek-talim.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/st.uzbek-talim.uz/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384";
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security Headers for Telegram Mini App
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Note: Telegram Mini Apps run in iframe, do NOT add rigid X-Frame-Options DENY

    location / {
        limit_req zone=general_limit burst=30 nodelay;

        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
