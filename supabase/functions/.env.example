# Server secrets for Supabase Edge Functions. In .gitignore: never commit it.
# Upload all at once:  npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.)

# --- AI (function "gemini") ---
# Google AI Studio -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Sites allowed to call the functions, comma separated (add the production domain later)
ALLOWED_ORIGINS=http://localhost:5173

# --- Telegram (functions "telegram-bot", "telegram-reminders", "bot-action", "admin-broadcast") ---
# @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=
# Generated random values; reuse the same ones in setWebhook and the pg_cron job (README)
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# Public site address used in bot messages, e.g. https://example.uz
APP_URL=http://localhost:5173

# --- Sign-in and admins ---
# Random value used to derive per-user passwords for Telegram sign-in. Generated; never change it
# after the first users sign in (they would lose access to their accounts).
AUTH_SECRET=
# Your Telegram numeric id (ask @userinfobot); several admins: comma separated
ADMIN_TELEGRAM_IDS=
# The owner: the only admin who can give other admins a login and password on the admin site (one id, or several
# separated by commas). Must also be in ADMIN_TELEGRAM_IDS. Empty = nobody can issue logins.
OWNER_TELEGRAM_IDS=

# Admin site address (https). The bot shows an "Admin" menu button with it to admins and moderators only
ADMIN_URL=
