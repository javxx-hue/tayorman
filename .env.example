# Browser (Mini App) settings. Copy this file to .env and fill it in.
# .env is in .gitignore: never commit it. VITE_ values are visible to every user, so only
# put public values here (never secret keys).

# Supabase -> Project Settings -> API -> "Project URL"
VITE_SUPABASE_URL=

# Supabase -> Project Settings -> API -> "anon public" key (safe for the browser)
VITE_SUPABASE_ANON_KEY=

# Telegram bot username from @BotFather, without @ (used for invite links and the voice answer button)
VITE_TELEGRAM_BOT=

# Server secrets do NOT go here. Put them in supabase/functions/.env and upload with:
#   npx supabase secrets set --env-file supabase/functions/.env
